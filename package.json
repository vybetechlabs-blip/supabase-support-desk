{
  "name": "supabase-support-desk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "test:db": "supabase db reset --local && supabase test db --local",
    "sql": "node scripts/sql.mjs",
    "embed:backfill": "node scripts/backfill-embeddings.mjs",
    "lab": "node lab/run.mjs",
    "by-hand": "node lab/common/by-hand.mjs",
    "test:unit": "node --test supabase/functions/triage/classify.test.ts",
    "check:triage-failure": "node scripts/check-triage-failure.mjs",
    "env:local": "node scripts/write-env-local.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "postgres": "^3.4.9",
    "supabase": "^2.119.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
