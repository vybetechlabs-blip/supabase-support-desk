# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets: never commit. Copy .env.example to .env.local / supabase/functions/.env
.env
.env.*
!.env.example
supabase/functions/.env
!supabase/functions/.env.example

# Lab output scratch
lab/out/

# Supabase CLI runtime state. `supabase start` copies function secrets into
# supabase/.temp/start-secrets/; supabase/.gitignore already excludes .temp, this
# repeats it at the root so it stays excluded even if that file changes.
supabase/.temp/
supabase/.branches/

# Lab evidence logs are committed on purpose (TROUBLESHOOTING.md quotes them);
# the *.log rule above would otherwise exclude them.
!lab/evidence/**/*.log

# Studio's SQL editor autosaves snippets here; they are scratch work.
supabase/snippets/
