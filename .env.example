# Copy to .env.local and fill from `npx supabase status`.
# Only the PUBLISHABLE key belongs here: everything prefixed VITE_ is shipped to the browser.
# Never put a secret (sb_secret_...) or service_role key in this file.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
